# Cadena de conexión de PostgreSQL (en Neon usa la URL "pooled")
DATABASE_URL="postgres://jobtracker:jobtracker@localhost:5432/jobtracker"

# Resend: https://resend.com/api-keys
# Sin RESEND_API_KEY los correos se imprimen en la consola (útil en desarrollo).
RESEND_API_KEY=""
# Remitente. Para enviar a cualquier destinatario necesitas un dominio verificado en Resend.
# Sin dominio, "onboarding@resend.dev" solo puede enviar al email de tu cuenta de Resend.
EMAIL_FROM="Job Tracker <onboarding@resend.dev>"

# Secreto que protege /api/cron/reminders (Vercel Cron lo envía como "Authorization: Bearer ...")
# Genera uno con: openssl rand -hex 32
CRON_SECRET=""

# URL pública de la app, usada en los enlaces de los correos
APP_URL="http://localhost:3000"

# Zona horaria con la que se calcula "hoy" para los recordatorios (IANA)
APP_TIMEZONE="Europe/Madrid"
